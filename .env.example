APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgresql://bazgain:bazgain@localhost:5433/bazgain_places?sslmode=disable
REDIS_URL=redis://localhost:6380/0
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_ISSUER=bazgain
JWT_AUDIENCE=bazgain-mobile
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
REQUEST_BODY_MAX_BYTES=1048576
HTTP_MAX_HEADER_BYTES=32768
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=30s
DB_QUERY_TIMEOUT=5s
DB_TX_TIMEOUT=10s
REDIS_DIAL_TIMEOUT=2s
REDIS_READ_TIMEOUT=1s
REDIS_WRITE_TIMEOUT=1s
PUBLIC_CACHE_TTL_SECONDS=60
PUBLIC_RATE_LIMIT=60
ADMIN_MUTATION_RATE_LIMIT=30
RATE_LIMIT_WINDOW_SECONDS=60
PLACE_PUBLIC_FEED_HARD_CAP=1000
COLLECTIONS_PUBLIC_FEED_HARD_CAP=100
TRUSTED_PROXY_CIDRS=
LOG_LEVEL=info
